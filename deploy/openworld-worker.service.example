[Unit]
Description=Openworld panel job worker
After=network.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/openworld/client
# Optional: set FLASK_SECRET_KEY to persist sessions across restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
EnvironmentFile=-/opt/openworld/client/.env
ExecStart=/opt/openworld/bin/python worker.py
Restart=always
RestartSec=5
# Hardening (optional)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
