# ===== Openworld panel — example environment =====
# Copy to .env and edit before `docker compose up -d`.

# Production marker. When set to "production", the app REQUIRES a stable
# FLASK_SECRET_KEY (it refuses to start with a random one, which would break
# sessions across gunicorn workers and on restart).
OPENWORLD_ENV=production

# Flask session secret. REQUIRED in production. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Set to "false" in the web container when running the separate worker service.
# (docker-compose already sets this per-service.)
WORKER_ENABLED_IN_WEB=false

# ----- Database -----
DB_ENGINE=mysql
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=openworld
MYSQL_PASSWORD=change-me-strong-password
MYSQL_DATABASE=openworld
MYSQL_ROOT_PASSWORD=change-me-root-password

# If using SQLite instead of MySQL:
# DB_ENGINE=sqlite
# SQLITE_PATH=/data/database.db

# ----- Storage: named volumes (default) or host folders (bind mounts) -----
# Leave these commented out to use Docker named volumes (db-data, panel-config,
# panel-data) — the simplest option, managed by Docker.
#
# To use host folders instead, uncomment and point them at local paths. Docker
# treats a relative/absolute path as a bind mount. The folders must exist and
# be writable by uid 10001 (the container user); `mkdir -p` them first.
#
#   DB_DATA=./data/mysql          # MariaDB data dir (folder)
#   PANEL_DATA=./data             # SQLite db + worker heartbeat (folder)
#   PANEL_CONFIG=./data/config.json   # panel settings — must be a FILE, not a folder
# DB_DATA=./data/mysql
# PANEL_DATA=./data
# PANEL_CONFIG=./data/config.json

# ----- Captcha service (optional) -----
# The panel talks to a captcha microservice; build & run the captcha image and
# point the panel at it via config.json (captcha.url/api_key/secret).
# CAPTCHA_URL=http://captcha:8000
